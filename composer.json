{
    "name": "very-code-com/furgonetka-api-php",
    "description": "PHP client for the Furgonetka.pl REST API: OAuth2, price comparison, shipments, labels, pickups, tracking, pickup points, returns, address book, notifications and webhooks. One API for DPD, InPost, DHL, UPS, GLS, FedEx, Poczta Polska, ORLEN Paczka and more.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["furgonetka", "courier", "shipping", "parcel", "logistics", "dpd", "inpost", "dhl", "ups", "gls", "poczta-polska", "oauth2", "rest", "api", "client", "webhook", "tracking", "labels"],
    "homepage": "https://github.com/very-code-com/furgonetka-api-php",
    "authors": [
        {
            "name": "Very Code",
            "homepage": "https://very-code.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "psr/log": "^2.0|^3.0"
    },
    "require-dev": {
        "ext-zlib": "*",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "VeryCodeCom\\FurgonetkaApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VeryCodeCom\\FurgonetkaApi\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
